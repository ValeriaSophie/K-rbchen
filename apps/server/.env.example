# Copy to .env and adjust. SQLite by default (zero-config dev).
DATABASE_URL="file:./dev.db"

# Session cookie signing secret (use a long random value in production).
SESSION_SECRET="dev-only-change-me-to-a-long-random-string"

# HTTP port for the Fastify API (and the built web app, when present).
PORT=3001

# Network interface to bind. 0.0.0.0 makes the site reachable from other
# devices (phone on the same WLAN, or through a Tailscale/Cloudflare tunnel).
# Set to 127.0.0.1 to keep it on this machine only.
HOST=0.0.0.0

# Set to "production" to enable secure cookies etc.
NODE_ENV=development
