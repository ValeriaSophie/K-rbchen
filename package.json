{
  "name": "koerbchen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/server && npm run build -w apps/web",
    "start": "npm run build && npm run start -w apps/server",
    "test": "npm run test -w apps/server && npm run test -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/server",
    "db:seed": "npm run db:seed -w apps/server",
    "db:reset": "npm run db:reset -w apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
